# ---- STM32CubeIDE / Eclipse CDT build output ----
Debug/
Release/
**/Debug/
**/Release/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.su
*.cyclo

# Eclipse CDT project state (keep .project/.cproject if you want the IDE config tracked;
# these are the parts that are machine-specific / regenerated)
.metadata/
.settings/
.launch
*.launch

# ---- Pico / arm-none-eabi-gcc build ----
build/
**/build/
pico_rp2040.elf
pico_rp2040.uf2
*.uf2
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
!Makefile.am

# ---- Generic object/binary noise ----
*.obj
*.exe
*.out
*.a
*.lib

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
__pycache__/
.venv/
.pytest_cache/
*.pyc
*.dSYM/

# Eclipse CDT / STM32CubeIDE machine-generated project metadata (not the
# same as tron_board/.osx.project, which is tracked deliberately)
.project
.cproject
# ...except the firmware project's own. They hold only relative paths, and
# Appli/.cproject carries the include paths and linked folders for core/ and
# board/ - without them a fresh clone can't build the DK firmware.
!tron_board/.project
!tron_board/Appli/.project
!tron_board/Appli/.cproject
!tron_board/FSBL/.project
!tron_board/FSBL/.cproject

# Local dashboard tool run-history state - not source
.dashboard_history.json

# Recorded live runs (Part 2 replay, laptop/tools/app.py's
# _RecordingWriter) - regenerated by every live run, can be large, and
# aren't source. One curated demo recording is kept for the replay demo
# path to always have something to load: seed 42, combined fault
# profile, 600 ticks (~227 KB gzipped) - chosen because it has a rich
# detection story (896 ELEVATED tier readings, 510 degraded readings
# across the run - see the "Next detection" jump), not just an empty
# happy-path run.
laptop/tools/recordings/*
!laptop/tools/recordings/demo_seed42_combined_600ticks.jsonl.gz

# Laptop build outputs (the root Makefile's TARGET and LABELER) and the
# dataset ./tron writes into its working directory - all regenerated
/tron
/label_snapshots
/tron_snapshot_dataset.csv

# The CMake rule above ("Makefile") also matches this project's own
# hand-written root Makefile, which is source - keep it trackable
!/Makefile

# Local working files, kept on disk but not part of the repo:
# a finished fix plan, the design doc of the retired consensus_weighting
# subsystem, a one-off pandas snippet, and an old stress-run log archive
# (stress_test.sh regenerates it; check-two-board-cbba-harness is the gate)
/TRON_FIX_PLAN.md
/consensus_weighting_design.md
/check.py
/stress_results.tar.gz

# Vendored T-License 2.2 BSPs — fetch separately per board vendor/README.md,
# do not commit (not a redistribution-friendly license to bundle verbatim)
board/STM32N6570-DK/vendor/mtk3_bsp2/
board/Raspberry_Pi_Pico/vendor/mtk3_bsp/