+static void rr_measure(const TeamState_t *team)
+{
+    int dx, dy, pass; unsigned L[2]={0,0}, P[2]={0,0}; int ok[2]={1,1};
+    if(!team_destination(team,&dx,&dy)) return;
+    for(pass=0; pass<2; pass++)
+    {
+        int x=team->loc_x, y=team->loc_y, steps=0;
+        if(pass==1) path_set_extra_cost(s_avoid);
+        while(!(x==dx && y==dy) && steps<400)
+        {
+            int nx=x, ny=y;
+            if(find_next_path_step(x,y,dx,dy,0,&nx,&ny)<=0){ ok[pass]=0; break; }
+            x=nx; y=ny; steps++;
+            if(in_grid(x,y) && fault_injector_causal_road_kind(x,y)==1u) P[pass]++;
+        }
+        if(steps>=400) ok[pass]=0;
+        L[pass]=steps;
+        path_set_extra_cost(NULL);
+    }
+    if(!ok[0]||!ok[1]){ rr_unreach++; return; }
+    rr_eps++; rr_sumL0+=L[0]; rr_sumL1+=L[1]; rr_sumP0+=P[0]; rr_sumP1+=P[1];
+    if(L[0]==L[1] && P[0]==P[1]) rr_samepath++;
